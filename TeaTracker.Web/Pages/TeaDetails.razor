@page "/teas/{Id:int}"
@inject TeaApiClient Api

<PageTitle>@(tea?.Title ?? "Détails")</PageTitle>

<h1>@(tea?.Title ?? "Détails")</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p>Chargement...</p>
}
else if (tea is null)
{
    if (errorMessage is null)
    {
        <p>Thé introuvable</p>
    }
}
else
{
    <p><span class="fw-bold">Marque : </span>@tea.Brand</p>
    <p><span class="fw-bold">Type : </span>@tea.TeaType.ToLabel()</p>
    <p><span class="fw-bold">Prix : </span>@tea.Price.ToString("0.00") €</p>
    <p><span class="fw-bold">Stock : </span>@tea.TeaBagCount sachets de thé</p>

    @if (tastings is null || tastings.Count == 0)
    {
        <p>Pas de dégustations pour ce thé</p>
    }
    else
    {
        <h2 class="fs-3">Dégustations :</h2>
        <p><span class="fw-bold">Moyenne : </span>@(tastings.Average(t => t.Rating).ToString("0.0")) / 5</p>

        <table class="table">
            <thead>
                <tr>
                    <th>Note (/5)</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TastingResponse tasting in tastings)
                {
                    <tr>
                        <td>@tasting.Rating</td>
                        <td>@tasting.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <button @onclick="() => DeleteTastingAsync(tasting.Id)" class="btn btn-outline-danger p-1 lh-1" title="Supprimer">&times;</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private TeaResponse? tea;
    private List<TastingResponse>? tastings;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = null;

        try
        {
            tea = await Api.GetTeaAsync(Id);
            tastings = tea is null ? null : await Api.GetTastingsAsync(Id);
        }
        catch (HttpRequestException)
        {
            tea = null;
            tastings = null;
            errorMessage = "Impossible de contacter l'API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteTastingAsync(int tastingId)
    {
        try
        {
            await Api.DeleteTastingAsync(Id, tastingId);
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Échec de la suppression (code {(int?)ex.StatusCode}).";
        }
    }
}
