@page "/teas"
@inject TeaApiClient Api


<PageTitle>Mes thés</PageTitle>

<h1>Mes thés</h1>

<a class="btn btn-success mb-3" href="teas/add">Ajouter un thé</a>

<div class="row g-2 mb-3">
    <div class="col-auto">
        <select class="form-select" @bind="selectedType">
            <option value="">--Selectionne un type--</option>
            @foreach (TeaType type in Enum.GetValues<TeaType>())
            {
                <option value="@type">@type.ToLabel()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input class="form-control" placeholder="Rechercher" @bind="search" />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="LoadAsync">Filtrer</button>
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (teas is null)
{
    <p>Chargement...</p>
}
else if (teas.Count == 0)
{
    <p>Aucun thé pour l'instant</p>
}
else
{
    <tabel class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Marque</th>
                <th>Type</th>
                <th>Prix</th>
                <th>Nombre de sachets</th>
            </tr>
        </thead>
        <tbody>
            @foreach (TeaResponse tea in teas)
            {
                <tr>
                    <td>@tea.Title</td>
                    <td>@tea.Brand</td>
                    <td>@tea.TeaType.ToLabel()</td>
                    <td>@tea.Price.ToString("0.00") €</td>
                    <td>@tea.TeaBagCount</td>
                </tr>
            }
        </tbody>
    </tabel>
}

@code {
    private List<TeaResponse>? teas;
    private string? errorMessage;
    private TeaType? selectedType;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = null;
        teas = null;

        try
        {
            teas = await Api.GetTeasAsync(selectedType, search);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de contacter l'API.";
        }
    }
}