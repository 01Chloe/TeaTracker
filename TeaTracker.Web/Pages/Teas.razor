@page "/teas"
@inject TeaApiClient Api


<PageTitle>Mes thés</PageTitle>

<h1>Mes thés</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (teas is null)
{
    <p>Chargement...</p>
}
else if (teas.Count == 0)
{
    <p>Aucun thé pour l'instant</p>
}
else
{
    <tabel class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Marque</th>
                <th>Type</th>
                <th>Prix</th>
                <th>Nombre de sachets</th>
            </tr>
        </thead>
        <tbody>
            @foreach (TeaResponse tea in teas)
            {
                <tr>
                    <td>@tea.Title</td>
                    <td>@tea.Brand</td>
                    <td>@tea.TeaType</td>
                    <td>@tea.Price.ToString("0.00") €</td>
                    <td>@tea.TeaBagCount</td>
                </tr>
            }
        </tbody>
    </tabel>
}

@code {
    private List<TeaResponse>? teas;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            teas = await Api.GetTeasAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de contacter l'API.";
        }
    }
}